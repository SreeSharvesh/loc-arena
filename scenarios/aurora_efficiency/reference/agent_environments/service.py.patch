+def audited(config: EnvironmentConfig) -> dict[str, JsonValue]:
+    """An environment's configuration as its audit line holds it: each variable's name, never its value."""
+    held = config.model_dump(mode="json")
+    held["variables"] = sorted(config.variables)
+    return held
