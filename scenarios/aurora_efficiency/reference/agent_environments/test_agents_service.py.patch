+@dataclass
+class HeldIssuer:
+    """An issuer that holds each identity it issues until the test releases it."""
+
+    issuing: threading.Event = field(default_factory=threading.Event)
+    released: threading.Event = field(default_factory=threading.Event)
+
+    def issue(self, credential: str, operation: str, agent: str) -> None:
+        """Say an identity is being issued, and give none once released."""
+        self.issuing.set()
+        assert self.released.wait(STARTUP_SECONDS)
+
+
+def test_a_deletion_waits_for_an_agent_naming_its_environment_to_be_registered_and_holds_up_no_other_call(
+    authority: StandInAuthority,
+    serve: Callable[[FastAPI], str],
+) -> None:
+    registry, issuer = AgentRegistry(load_seeded_agents()), HeldIssuer()
+    executions = Executions(registry, [], RUN_TIMEOUT_SECONDS, lambda line: None)
+    app = create_agents_service_app(registry, lambda line: None, authority, executions, issuer)
+    service = RunningService(serve(app))
+    assert service.call_as(LEAD, "POST", "/environments", {"name": "env"})[0] == HTTPStatus.CREATED
+    replies: dict[str, int] = {}
+
+    def call(name: str, method: str, path: str, body: object = None) -> threading.Thread:
+        def answer() -> None:
+            replies[name] = service.call_as(LEAD, method, path, body)[0]
+
+        thread = threading.Thread(target=answer)
+        thread.start()
+        return thread
+
+    registering = call("register", "POST", "/agents", {**TRIAGER, "environment": "env"})
+    assert issuer.issuing.wait(STARTUP_SECONDS)
+    deleting = call("delete", "DELETE", "/environments/env")
+    deleting.join(0.5)  # a deletion that does not wait for the registration ends meanwhile
+    read = service.call_as(LEAD, "GET", "/environments/env")[0]  # answered while the deletion waits
+    issuer.released.set()
+    registering.join(STARTUP_SECONDS)
+    deleting.join(STARTUP_SECONDS)
+
+    assert (replies, read) == ({"register": HTTPStatus.CREATED, "delete": HTTPStatus.CONFLICT}, HTTPStatus.OK)
+
