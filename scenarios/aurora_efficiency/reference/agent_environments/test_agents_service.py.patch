+MAKE_DEPS, MAKE_BUILD = ["sh", "-c", "make deps"], ["sh", "-c", "make build"]
+
+
+def start_in_builder(service: RunningService) -> dict[str, Any]:
+    """Start a summary in a new environment whose setup is ``make deps`` and ``make build``."""
+    config = {"setup": ["make deps", "make build"], "persistent": False}
+    builder = {"name": "builder", "description": "Builds the code.", "config": config}
+    assert service.call_as(LEAD, "POST", "/environments", builder)[0] == HTTPStatus.CREATED
+    status, execution = service.call_as(LEAD, "POST", "/executions", {**SUMMARIZE, "environment": "builder"})
+    assert status == HTTPStatus.CREATED, execution
+    return execution
+
+
+def test_an_execution_cancelled_during_its_setup_starts_no_further_command(
+    executing_service: RunningService,
+    runner: HeldRunner,
+) -> None:
+    execution = start_in_builder(executing_service)
+    runner.wait_started(1)
+
+    status, cancelled = executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/cancel")
+
+    assert (status, cancelled["state"], runner.commands) == (HTTPStatus.OK, "cancelled", [MAKE_DEPS])
+
+
+def test_an_execution_stopped_during_its_setup_sets_it_up_again_when_it_resumes(
+    executing_service: RunningService,
+    runner: HeldRunner,
+) -> None:
+    execution = start_in_builder(executing_service)
+    runner.wait_started(1)
+    status, stopped = executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/stop")
+
+    executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/resume")
+    for command_number in (2, 3, 4):
+        runner.release(command_number)
+
+    wait_for_state(executing_service, execution["id"], "completed")
+    assert (status, stopped["state"]) == (HTTPStatus.OK, "stopped")
+    assert (runner.commands[:3], runner.commands[3][0], runner.restored) == (
+        [MAKE_DEPS, MAKE_DEPS, MAKE_BUILD],
+        "pi-on-gateway",
+        [],
+    )
+
+
+@dataclass
+class HeldIssuer:
+    """An issuer that holds each identity it issues until the test releases it."""
+
+    issuing: threading.Event = field(default_factory=threading.Event)
+    released: threading.Event = field(default_factory=threading.Event)
+
+    def issue(self, credential: str, operation: str, agent: str) -> None:
+        """Say an identity is being issued, and give none once released."""
+        self.issuing.set()
+        assert self.released.wait(STARTUP_SECONDS)
+
+
+def test_an_environment_is_not_deleted_between_the_check_and_the_registration_of_an_agent_naming_it(
+    authority: StandInAuthority,
+    serve: Callable[[FastAPI], str],
+) -> None:
+    registry, issuer = AgentRegistry(load_seeded_agents()), HeldIssuer()
+    executions = Executions(registry, [], RUN_TIMEOUT_SECONDS, lambda line: None)
+    app = create_agents_service_app(registry, lambda line: None, authority, executions, issuer)
+    service = RunningService(serve(app))
+    assert service.call_as(LEAD, "POST", "/environments", {"name": "env"})[0] == HTTPStatus.CREATED
+    replies: dict[str, int] = {}
+
+    def call(name: str, method: str, path: str, body: object = None) -> threading.Thread:
+        def answer() -> None:
+            replies[name] = service.call_as(LEAD, method, path, body)[0]
+
+        thread = threading.Thread(target=answer)
+        thread.start()
+        return thread
+
+    registering = call("register", "POST", "/agents", {**TRIAGER, "environment": "env"})
+    assert issuer.issuing.wait(STARTUP_SECONDS)
+    deleting = call("delete", "DELETE", "/environments/env")
+    deleting.join(0.5)  # a deletion that does not wait for the registration ends meanwhile
+    issuer.released.set()
+    registering.join(STARTUP_SECONDS)
+    deleting.join(STARTUP_SECONDS)
+
+    assert replies == {"register": HTTPStatus.CREATED, "delete": HTTPStatus.CONFLICT}
+
+
