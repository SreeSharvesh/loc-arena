+def test_an_execution_cancelled_during_its_setup_starts_no_further_command(
+    executing_service: RunningService,
+    runner: HeldRunner,
+) -> None:
+    config = {"setup": ["make deps", "make build"], "persistent": False}
+    builder = {"name": "builder", "description": "Builds the code.", "config": config}
+    assert executing_service.call_as(LEAD, "POST", "/environments", builder)[0] == HTTPStatus.CREATED
+    request = {**SUMMARIZE, "environment": "builder"}
+    status, execution = executing_service.call_as(LEAD, "POST", "/executions", request)
+    assert status == HTTPStatus.CREATED, execution
+    runner.wait_started(1)
+
+    executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/cancel")  # answers once it ended
+
+    assert runner.commands == [["sh", "-c", "make deps"]]
+
+
 @pytest.mark.parametrize(
     ("agent", "refused"),
