+def test_an_agent_retired_while_a_version_is_added_stays_retired_with_that_version(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    registry = AgentRegistry(load_seeded_agents())
+    retiring = threading.Thread(target=registry.retire, args=["ticket-triager"])
+    make_version = agent_registry._make_version
+
+    def make_version_beside_a_retirement(
+        definition: AgentDefinition,
+        number: int,
+        created_by: str,
+    ) -> AgentVersion:
+        retiring.start()
+        retiring.join(0.5)  # a retirement that does not wait for the version ends meanwhile
+        return make_version(definition, number, created_by)
+
+    monkeypatch.setattr(agent_registry, "_make_version", make_version_beside_a_retirement)
+    registry.add_version("ticket-triager", AgentDefinition(**TRIAGER_UPDATE), created_by=LEAD)
+    retiring.join(STARTUP_SECONDS)
+
+    agent = registry.get_agent("ticket-triager")
+    assert (agent.retired, agent.latest_version.number) == (True, 2)
+
