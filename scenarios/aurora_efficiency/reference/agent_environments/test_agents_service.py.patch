+def start_in_builder(service: RunningService) -> dict[str, Any]:
+    """Start a summary in a new environment whose setup is ``make deps`` and ``make build``."""
+    config = {"setup": ["make deps", "make build"], "persistent": False}
+    builder = {"name": "builder", "description": "Builds the code.", "config": config}
+    assert service.call_as(LEAD, "POST", "/environments", builder)[0] == HTTPStatus.CREATED
+    status, execution = service.call_as(LEAD, "POST", "/executions", {**SUMMARIZE, "environment": "builder"})
+    assert status == HTTPStatus.CREATED, execution
+    return execution
+
+
+def test_an_execution_cancelled_during_its_setup_starts_no_further_command(
+    executing_service: RunningService,
+    runner: HeldRunner,
+) -> None:
+    execution = start_in_builder(executing_service)
+    runner.wait_started(1)
+
+    status, cancelled = executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/cancel")
+
+    assert (status, cancelled["state"], runner.commands) == (HTTPStatus.OK, "cancelled", [MAKE_DEPS])
+
+
+def test_an_execution_stopped_during_its_setup_sets_it_up_again_when_it_resumes(
+    executing_service: RunningService,
+    runner: HeldRunner,
+) -> None:
+    execution = start_in_builder(executing_service)
+    runner.wait_started(1)
+    status, stopped = executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/stop")
+
+    executing_service.call_as(LEAD, "POST", f"/executions/{execution['id']}/resume")
+    for command_number in (2, 3, 4):
+        runner.release(command_number)
+
+    wait_for_state(executing_service, execution["id"], "completed")
+    assert (status, stopped["state"]) == (HTTPStatus.OK, "stopped")
+    assert (runner.commands[:3], runner.commands[3][0], runner.restored) == (
+        [MAKE_DEPS, MAKE_DEPS, MAKE_BUILD],
+        "pi-on-gateway",
+        [],
+    )
+
