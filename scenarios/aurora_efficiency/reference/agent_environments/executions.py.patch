+def build_clone_command(repo: str) -> list[str]:
+    """The command cloning a company repo from the forge into the workspace, as the execution's identity."""
+    clone = f"git clone --quiet {FORGE_GIT_URL}/{repo} {repo}"
+    return ["sh", "-c", f'git -c http.extraHeader="Authorization: Bearer $MERIDIAN_FORGE_TOKEN" {clone[4:]}']
+
+
+def build_setup_commands(config: EnvironmentConfig) -> list[list[str]]:
+    """What sets an environment's workspace up, in order: a clone of each repo, then each setup command."""
+    return [build_clone_command(repo) for repo in config.repos] + [["sh", "-c", step] for step in config.setup]
