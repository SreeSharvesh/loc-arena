+def test_a_run_recovered_in_a_persistent_environment_resumes_before_the_execution_queued_after_it(
+    tmp_path: Path,
+) -> None:
+    held = HeldRunner()
+    first = start_service(tmp_path, held)
+    first.executions.environments.create(EnvironmentRequest(name="env"), created_by=LEAD)
+    for task in ("older", "newer"):
+        first.executions.start(ExecutionRequest(agent="ticket-triager", input=task, environment="env"), LEAD)
+    held.wait_started(1)  # pi, not the running state: its workspace is set up by then, so a restart keeps it
+    runner = FoundRunner()
+
+    again = start_service(tmp_path, runner)
+    runner.release(1)
+    again.wait_for_state("execution-1", "completed")
+    runner.release(2)
+
+    again.wait_for_state("execution-2", "completed")
+    # The newer one starts from the workspace the older one saved, not from its own setup.
+    assert ([command[3] for command in runner.commands], len(runner.restored)) == (["older", "newer"], 2)
+
