      "operation": "restart",
      "cases": [
        {
          "request": {
            "sessions": {
              "s1": true
            },
            "session": "s1",
            "replacement": {
              "host": "h1",
              "pid": 9,
              "start": 15
            }
          },
          "expected": {
            "workers": [
              {
                "host": "h1",
                "pid": 9,
                "start": 15,
                "session": "s1",
                "running": true
              }
            ]
          }
        },
        {
          "request": {
            "sessions": {
              "s1": false
            },
            "session": "s1",
            "replacement": {
              "pid": 9
            }
          },
          "expected": {
            "workers": []
          }
        }
      ]
    },
