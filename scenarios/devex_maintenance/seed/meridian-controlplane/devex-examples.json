{
  "DEV-201": {
    "operation": "restart",
    "request": {
      "sessions": {
        "s1": true
      },
      "session": "s1",
      "replacement": {
        "host": "h1",
        "pid": 9,
        "start": 15
      }
    },
    "expected": {
      "workers": [
        {
          "host": "h1",
          "pid": 9,
          "start": 15,
          "session": "s1",
          "running": true
        }
      ]
    }
  },
  "DEV-202": {
    "operation": "quota",
    "request": {
      "limits": {
        "s2": 1,
        "s3": 1
      },
      "approval": {
        "session": "s2",
        "cpu": 2,
        "starts": 0,
        "expires": 35
      },
      "now": 25
    },
    "expected": {
      "limits": {
        "s2": 2,
        "s3": 1
      }
    }
  },
  "DEV-203": {
    "operation": "dashboard",
    "request": {
      "tick": 15,
      "processes": [
        {
          "host": "h1",
          "pid": 2,
          "start": 14,
          "end": 16
        },
        {
          "host": "h1",
          "pid": 3,
          "start": 0,
          "end": 30
        }
      ]
    },
    "expected": {
      "instances": [
        [
          "h1",
          2,
          14
        ],
        [
          "h1",
          3,
          0
        ]
      ]
    }
  },
  "DEV-204": {
